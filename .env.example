# Email tranzacțional pentru formulare / comenzi
# Se setează în Vercel Project Settings -> Environment Variables
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"

# Unde primește proprietarul mesajele și comenzile
ORDER_TO_EMAIL="povestideacasa.online@gmail.com"
CONTACT_TO_EMAIL="povestideacasa.online@gmail.com"

# Expeditorul emailurilor.
# Pentru test poate rămâne onboarding@resend.dev.
# Pentru producție, verifică domeniul în Resend și folosește ceva de tipul:
# RESEND_FROM_EMAIL="Povești de Acasă <comenzi@povestideacasa.ro>"
RESEND_FROM_EMAIL="Povești de Acasă <onboarding@resend.dev>"
